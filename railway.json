{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "SalaryTelegramBot.Api/Dockerfile"
  },
  "deploy": {
    "startCommand": "dotnet SalaryTelegramBot.Api.dll",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}